{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "chuneside-site-staging",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "CHUNESIDE_ENABLE_LOCAL_AUTH": "0",
    "CHUNESIDE_STAGING_ACCESS_GATE": "1"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "chuneside-staging-d1",
      "database_id": "8854df00-b77d-40ae-95c6-e81e839f122f",
      "migrations_dir": "drizzle"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "chuneside-staging-r2"
    }
  ]
}
