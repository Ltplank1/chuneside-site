# ChuneSide current baseline
#
# No application-managed passwords, OAuth secrets, or API keys are required by
# the current source. The hosted runtime injects the Cloudflare D1 binding as
# `env.DB`, based on `.openai/hosting.json`, and Sites supplies authenticated
# member identity through trusted request headers.
#
# Optional build-script timeouts (normally leave unset):
# SITES_INSTALL_TIMEOUT=8m
# SITES_INSTALL_KILL_AFTER=15s
# SITES_BUILD_TIMEOUT=3m
# SITES_BUILD_KILL_AFTER=10s
#
# Comma-separated email allowlist for protected ChuneSide Admin screens.
# Example: CHUNESIDE_ADMIN_EMAILS=owner@example.com,manager@example.com
# This must include the verified email that will sign in first after Supabase is enabled.
CHUNESIDE_ADMIN_EMAILS=

# Local-only test auth. Ignored in production. When set to 1, local requests can
# use x-chuneside-local-user-id, x-chuneside-local-user-email, and
# x-chuneside-local-user-full-name headers for Admin/API verification.
CHUNESIDE_ENABLE_LOCAL_AUTH=0

# Supabase production Auth. Obtain both values from the Supabase project's
# Connect dialog. Keep the publishable key client-safe; never add a service-role
# key, a Google client secret, or an SMTP credential to committed environment files.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
